{
  "name": "ande-dashboard",
  "version": "3.3.0",
  "description": "Dashboard de Monitoreo ANDE - Zona Este",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "npm install",
    "reset-db": "rm -f ande_database.db && node server.js",
    "insert-ejemplo": "curl -X POST http://localhost:10000/api/insertar-ejemplo-inicial",
    "test": "echo \"Error: no test specified\" && exit 1",
    "reimport:xlsx": "node scripts/reimport_from_xlsx.js --xlsx datos.xlsx --db ANDE.db --truncate",
    "reimport:xlsx:dry": "node scripts/reimport_from_xlsx.js --xlsx datos.xlsx --db ANDE.db --dry-run"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "cors": "^2.8.5",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "ande",
    "dashboard",
    "monitoring",
    "energy",
    "paraguay"
  ],
  "author": "Nahum Velazquez",
  "license": "MIT"
}
